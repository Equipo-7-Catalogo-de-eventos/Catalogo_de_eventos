{
  "info": {
    "name": "Coleccion_Integracion_Catalogo_de_Eventos_v2",
    "description": "Colección oficial de pruebas de integración para el microservicio Catálogo de Eventos (ms-catalogo-eventos). Alineada con los endpoints principales del proyecto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
