    {
      "name": "2. API Principal Catálogo de Eventos",
      "item": [
        {
          "name": "GET Listar Eventos (Paginación y Filtros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalogo/eventos?busqueda=rock&categoria=Conciertos&estado=proximos&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalogo",
                "eventos"
              ],
              "query": [
                {
                  "key": "busqueda",
                  "value": "rock"
                },
                {
                  "key": "categoria",
                  "value": "Conciertos"
                },
                {
                  "key": "estado",
                  "value": "proximos"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "GET Detalle de Evento con es_pasado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalogo/eventos/evt_123456",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalogo",
                "eventos",
                "evt_123456"
              ]
            }
          }
        }
      ]
    },
