{
  "openapi": "3.0.3",
  "info": {
    "title": "API Microservicio Catálogo de Eventos - Equipo 7",
    "description": "Especificación OpenAPI 3.0 para el microservicio Catálogo de Eventos (TicketU - ms-catalogo-eventos). Contiene la API principal del catálogo, los endpoints expuestos a otros squads (Reseñas y Entradas/Inventario) y los endpoints del sistema.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de Desarrollo Local"
    },
    {
      "url": "https://api.ticketu.cl",
      "description": "Servidor de Producción / API Gateway"
    }
  ],
  "tags": [
    {
      "name": "Sistema y Monitoreo",
      "description": "Endpoints de salud y documentación de la API"
    },
    {
      "name": "Catálogo de Eventos",
      "description": "Búsqueda, filtrado y detalle de eventos para clientes"
    },
    {
      "name": "Integración con Reseñas (BE3)",
      "description": "Endpoints expuestos para la validación y datos mínimos de eventos"
    },
    {
      "name": "Integración con Entradas / Inventario",
      "description": "Endpoints expuestos para sincronización de stock de entradas"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Chequeo de salud del servicio",
        "description": "Verifica el estado operativo del microservicio y la disponibilidad del servidor Express.",
        "tags": [
          "Sistema y Monitoreo"
        ],
        "responses": {
          "200": {
            "description": "Servicio saludable y operativo",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "servicio": "ms-catalogo-eventos",
                  "timestamp": "2026-09-29T20:45:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/api-docs": {
      "get": {
        "summary": "Documentación interactiva Swagger OpenAPI 3.0",
        "description": "Despliega la interfaz gráfica Swagger UI para exploración y prueba interactiva de endpoints.",
        "tags": [
          "Sistema y Monitoreo"
        ],
        "responses": {
          "200": {
            "description": "Interfaz Swagger UI cargada exitosamente"
          }
        }
      }
    },
    "/api/catalogo/eventos": {
      "get": {
        "summary": "Listar eventos con filtros avanzados, búsqueda y paginación",
        "description": "Obtiene la lista de eventos disponibles (próximos o pasados) con capacidades de filtro por texto, categoría y paginación.",
        "tags": [
          "Catálogo de Eventos"
        ],
        "parameters": [
          {
            "name": "busqueda",
            "in": "query",
            "required": false,
            "description": "Texto para filtrar por nombre o descripción del evento",
            "schema": {
              "type": "string",
              "example": "rock"
            }
          },
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "description": "Categoría temática del evento",
            "schema": {
              "type": "string",
              "example": "Conciertos"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "description": "Filtrar por estado del evento (proximos / pasados)",
            "schema": {
              "type": "string",
              "enum": [
                "proximos",
                "pasados"
              ],
              "default": "proximos"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Número de página para la paginación",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Cantidad de eventos por página",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de eventos obtenido exitosamente",
            "content": {
              "application/json": {
                "example": {
                  "total": 1,
                  "page": 1,
                  "limit": 10,
                  "data": [
                    {
                      "id": "evt_123456",
                      "titulo": "Festival de Música TicketU 2026",
                      "categoria": "Conciertos",
                      "lugar": "Movistar Arena, Santiago",
                      "fecha": "2026-10-15T20:00:00Z",
                      "imagen": "https://cdn.ticketu.cl/images/evt_123456.jpg",
                      "precio": 25000,
                      "es_gratis": false,
                      "es_pasado": false,
                      "stock": 45,
                      "estado": "DISPONIBLE"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogo/eventos/{id}": {
      "get": {
        "summary": "Detalle del evento con notas y campo es_pasado",
        "description": "Retorna la información completa de un evento específico, incluyendo notas organizativas, bandera es_pasado y resumen visual.",
        "tags": [
          "Catálogo de Eventos"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único del evento",
            "schema": {
              "type": "string",
              "example": "evt_123456"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del evento obtenido exitosamente",
            "content": {
              "application/json": {
                "example": {
                  "id": "evt_123456",
                  "titulo": "Festival de Música TicketU 2026",
                  "descripcion": "El festival de música universitaria más grande del país.",
                  "categoria": "Conciertos",
                  "lugar": "Movistar Arena, Santiago",
                  "fecha": "2026-10-15T20:00:00Z",
                  "imagen": "https://cdn.ticketu.cl/images/evt_123456.jpg",
                  "precio": 25000,
                  "es_gratis": false,
                  "es_pasado": false,
                  "stock": 45,
                  "estado": "DISPONIBLE",
                  "notas": "Apertura de puertas a las 18:00 hrs. Mayores de 18 años.",
                  "organizador": "Federación de Estudiantes TicketU"
                }
              }
            }
          },
          "404": {
            "description": "Evento no encontrado",
            "content": {
              "application/json": {
                "example": {
                  "mensaje": "Evento no encontrado"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogo/eventos/{id}/info-servicio": {
      "get": {
        "summary": "Datos mínimos para Reseñas y Promociones (BE3)",
        "description": "Endpoint liviano expuesto para otros microservicios (Reseñas, Promociones) para validar la existencia de un evento y obtener datos de contexto básico sin transferir objetos pesados.",
        "tags": [
          "Integración con Reseñas (BE3)"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único del evento a validar",
            "schema": {
              "type": "string",
              "example": "evt_123456"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evento validado exitosamente",
            "content": {
              "application/json": {
                "example": {
                  "existe": true,
                  "id_evento": "evt_123456",
                  "nombre": "Festival de Música TicketU 2026",
                  "fecha": "2026-10-15T20:00:00Z",
                  "tipo": "pagado"
                }
              }
            }
          },
          "404": {
            "description": "El evento no existe en el catálogo",
            "content": {
              "application/json": {
                "example": {
                  "existe": false,
                  "id_evento": "evt_123456"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogo/eventos/{id}/stock": {
      "put": {
        "summary": "Actualizar stock desde Entradas/Inventario (conforme a contrato)",
        "description": "Endpoint expuesto para que el microservicio de Entradas e Inventario notifique y actualice el stock restante de entradas de un evento tras la confirmación de una compra.",
        "tags": [
          "Integración con Entradas / Inventario"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador del evento a actualizar",
            "schema": {
              "type": "string",
              "example": "evt_123456"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nuevo_stock"
                ],
                "properties": {
                  "nuevo_stock": {
                    "type": "integer",
                    "example": 43,
                    "description": "Nueva cantidad de stock de entradas disponible"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock actualizado exitosamente",
            "content": {
              "application/json": {
                "example": {
                  "mensaje": "Stock actualizado exitosamente",
                  "id_evento": "evt_123456",
                  "nuevo_stock": 43
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de entrada inválidos",
            "content": {
              "application/json": {
                "example": {
                  "mensaje": "El nuevo stock debe ser un entero mayor o igual a 0"
                }
              }
            }
          },
          "404": {
            "description": "Evento no encontrado",
            "content": {
              "application/json": {
                "example": {
                  "mensaje": "Evento no encontrado"
                }
              }
            }
          }
        }
      }
    }
  }
}